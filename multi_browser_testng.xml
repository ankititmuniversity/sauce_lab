<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Suite">
	<listeners>
		<listener class-name="retry.AnnotationTransformer"></listener>
		<listener class-name="retry.TestListener"></listener>
	</listeners>

	<test name="TestChrome" parallel="classes" thread-count="2">
		<parameter name="browser" value="chrome" />
		<classes>
			<class name="tests.LoginPageTest" />
			<class name="tests.ProductPageTest" />
		</classes>
	</test>
	<test name="TestEdge" parallel="classes" thread-count="2">
		<parameter name="browser" value="edge" />
		<classes>
			<class name="tests.CartPageTest" />
			<class name="tests.CheckoutPageTest" />
		</classes>
	</test>
	<test name="TestFireFox" parallel="classes" thread-count="2">
		<parameter name="browser" value="firefox" />
		<classes>
			<class name="tests.PaymentPageTest" />
			<class name="tests.OrderConfirmationPageTest" />
		</classes>
	</test>
</suite> <!--Suite -->
